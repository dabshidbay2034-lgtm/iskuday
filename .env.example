# Template only — NEVER put real keys in this file. It is committed to git.
# Copy to .env (gitignored) and fill in real values there.
#
# Only VITE_-prefixed vars reach the browser bundle, so never give a secret
# (Clerk secret key, Supabase service-role key) a VITE_ prefix.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# Publishable key — starts with pk_. Clerk Dashboard → API Keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Optional — see docs/CLERK_SETUP.md section 4.
# Set to "supabase" ONLY if you used Option A (classic Clerk JWT template).
# Leave unset for Option B (native Clerk<->Supabase integration).
# VITE_CLERK_SUPABASE_JWT_TEMPLATE=supabase

# Server-side only — set as Supabase edge function secrets, NOT as VITE_ vars:
#   CLERK_SECRET_KEY          — starts with sk_. Server/edge code only.
#   CLERK_WEBHOOK_SECRET      — Svix signing secret for the clerk-webhook function
#   SUPABASE_SERVICE_ROLE_KEY — used by clerk-webhook to upsert profiles
